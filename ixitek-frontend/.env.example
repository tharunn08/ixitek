# Copy this file to `.env` in ixitek-frontend/ and fill in your own values.
# Vite only exposes variables prefixed with VITE_ to the browser, and it
# inlines them at BUILD time — restart `npm run dev` / rebuild after any
# change.

# ── Backend API ──────────────────────────────────────────────────────────
# URL of the ixitek-backend server (see ../ixitek-backend). Sign in, sign
# up, enquiries and the admin panel all talk to this.
#
# Local dev (frontend on :5173, backend on :5000 — separate origins):
VITE_API_URL=http://localhost:5000
#
# Production (this project's deployment target): leave VITE_API_URL UNSET
# (or blank). ixitek-backend serves the built frontend and the /api/*
# routes from the SAME origin (e.g. https://ixitek.com), so the frontend
# automatically calls relative paths like /api/auth/login instead — no
# domain to hardcode, and it keeps working if the domain ever changes. See
# src/lib/api.js. Only set VITE_API_URL in production if the API genuinely
# lives on a different origin than the frontend.

# ── Where enquiries should reach you ────────────────────────────────────
# Inbox that receives the automatic "new enquiry" email.
VITE_ADMIN_EMAIL=sales@ixitek.in

# WhatsApp number for the floating "Chat on WhatsApp" button and the
# post-submit "notify us on WhatsApp" links. Digits only, with country code,
# no +, spaces or dashes (e.g. India number +91 99452 22724 -> 919945222724).
VITE_ADMIN_WHATSAPP=919945222724

# ── EmailJS (https://www.emailjs.com) — sends the automatic email ──────
# Free tier is enough for a small business site. Leave these three blank to
# disable automatic email sending (enquiries are still saved to the admin
# panel either way). See ADMIN_SETUP.md for the 5-minute setup.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
