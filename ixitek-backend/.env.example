# Copy this file to `.env` in ixitek-backend/ and fill in your own values.

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API.
# Add your production domain(s) here once deployed, e.g.:
# CORS_ORIGIN=http://localhost:5173,https://www.ixitek.in
CORS_ORIGIN=http://localhost:5173

# ── Database (SQLite — no server/account to set up) ────────────────────
# A single local file database via db.js (see src/db.js). Leave this
# unset and it defaults to ixitek-backend/data/ixitek.db, created
# automatically on first start. WAL mode + fsync-on-commit are enabled in
# db.js so a crash mid-write can't corrupt already-saved data.
DB_PATH=./data/ixitek.db

# ── Backups (protects against a deleted/corrupted file, not just crashes) ─
# The server takes an automatic, safe "hot" backup (the app can keep
# running/writing during it) on this interval, written to
# ixitek-backend/data/backups/, and prunes anything past BACKUP_RETENTION.
# You can also trigger one any time with `npm run backup`, or as the owner
# via POST /api/admin/backups. See README.md → "Backups & data durability".
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION=30
# BACKUP_DIR=./data/backups

# ── Auth ─────────────────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# ── Owner / primary admin account (auto-created on first server start) ──
# Sign in with these on the site's login page to reach the admin panel.
# Change OWNER_PASSWORD before going live, and again afterwards from a
# real device — this only seeds the account once.
OWNER_NAME=Ixitek Admin
OWNER_EMAIL=admin@ixitek.in
OWNER_PASSWORD=Ixitek@2026
