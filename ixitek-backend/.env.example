# ixitek-backend configuration. Copy to `.env` for local use; in production
# (Hostinger Node.js Web App) set these as environment variables in hPanel.
# Values containing "#" must be quoted, e.g. OWNER_PASSWORD="Abc#123".

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Extra origins allowed to call /api (the site's own origin is always allowed).
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of Node (Hostinger = 1). Default: 1 in production.
# TRUST_PROXY=1

# ── MySQL (required) ─────────────────────────────────────────────────────
# Create the database in Hostinger hPanel → Databases → MySQL Databases.
# The schema is created/upgraded automatically on start (src/migrations).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ixitek
DB_PASSWORD=change-me
DB_NAME=ixitek
DB_POOL_SIZE=10
# DB_SSL=true
# Queries slower than this are logged as "slow query".
DB_SLOW_QUERY_MS=500
# Set to false to run migrations manually (npm run migrate) instead of on start.
AUTO_MIGRATE=true

# ── Auth ─────────────────────────────────────────────────────────────────
# At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
# Sessions use httpOnly cookies. Secure cookies are on automatically in production.
# COOKIE_SECURE=true
AUTH_MAX_FAILED_LOGINS=8
AUTH_LOCK_MINUTES=15

# ── Owner account (created once on first start if it doesn't exist) ─────
OWNER_NAME=Ixitek Admin
OWNER_EMAIL=admin@ixitek.in
# Required in production. Never reuse the old published default.
OWNER_PASSWORD="choose-a-strong-password"

# ── Files (résumés, import uploads). Keep OUTSIDE the deployed app folder ─
STORAGE_DRIVER=local
# STORAGE_DIR=/home/<user>/ixitek-data/storage
MAX_IMPORT_MB=15

# ── Backups (verified MySQL dumps). Keep OUTSIDE the app folder too ───────
# One tiered backup per day (monthly on the 1st, weekly on Sundays, else daily)
# plus an "interval" backup every BACKUP_INTERVAL_HOURS (set 24 to disable).
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=5
BACKUP_KEEP_MONTHLY=12
BACKUP_KEEP_INTERVAL=8
BACKUP_KEEP_OTHER=10
# BACKUP_DIR=/home/<user>/ixitek-data/backups
# BACKUPS_ENABLED=true
# A verified backup is taken automatically before any schema migration.
# PRE_MIGRATION_BACKUP=true
# Empty database used by the weekly automated restore test (create it in hPanel).
# BACKUP_RESTORE_TEST_DB=u123_ixitek_restoretest

# ── Background jobs (imports, image checks, price recalculation) ─────────
JOBS_ENABLED=true
JOBS_POLL_MS=2000
IMAGE_CHECK_TIMEOUT_MS=8000

# ── Public site URL (links in emails, sitemap, canonical URLs) ───────────
PUBLIC_SITE_URL=http://localhost:5173

# ── Exchange rates (USD base). Manual/override rates are set in Admin ────
# FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
FX_REFRESH_HOURS=6
# FX_AUTO_REFRESH=false

# ── Razorpay (payments). Test keys start rzp_test_, live keys rzp_live_ ──
# Online payment is offered only when both keys are set (and only in
# currencies enabled for Razorpay in Admin → International).
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay Dashboard → Webhooks (URL: https://<domain>/api/webhooks/razorpay)
# RAZORPAY_WEBHOOK_SECRET=

# ── Transactional email (server-side outbox) ─────────────────────────────
# EMAIL_PROVIDER = smtp | resend | sendgrid | log (dev: printed, not sent) | none
EMAIL_PROVIDER=log
# EMAIL_FROM=orders@ixitek.in
# SMTP (Hostinger mail, Zoho, Google Workspace, Amazon SES SMTP …)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=orders@ixitek.in
# SMTP_PASS=
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# Fallback internal inbox if Admin → Finance → Business settings has none.
# SALES_INBOX=sales@ixitek.in

# ── Images ────────────────────────────────────────────────────────────────
# Product images are resized to WebP/AVIF on demand by /api/img (needs the
# optional "sharp" package) and cached under STORAGE_DIR/img-cache.
# IMAGE_MAX_MB=15
# IMAGE_FETCH_TIMEOUT_MS=10000

# ── Legacy SQLite (only read by `npm run migrate:legacy`) ────────────────
# LEGACY_SQLITE_PATH=./data/ixitek.db
