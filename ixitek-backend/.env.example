# Copy this file to `.env` in ixitek-backend/ and fill in your own values.
#
# In production (e.g. Hostinger's Node.js Web App), you normally do NOT
# create a `.env` file at all — set these same names as environment
# variables in the hosting panel instead. `.env` is only for local/VPS use
# and is loaded from ixitek-backend/.env no matter where the process is
# started from (see src/server.js); it never overrides a variable the
# platform already injected.

# ── Server ───────────────────────────────────────────────────────────────
# Do NOT hardcode a production port. Hostinger (and most Node.js hosts)
# injects PORT itself and routes your domain to it; the value below is only
# used as a local-development fallback if PORT isn't set.
PORT=5000
NODE_ENV=development
# In production set: NODE_ENV=production

# Comma-separated list of frontend origins allowed to call this API.
# In THIS project's deployment (one Node app serves both the frontend and
# the API from the same origin, see app.js), the browser mostly never sends
# a cross-origin request at all — but set your real production domain(s)
# here anyway as a safety net (e.g. if the site is also reachable at a
# "www." alias). Never use "*" — requests are sent with credentials
# (the Bearer auth token).
# Production example:
# CORS_ORIGIN=https://ixitek.com,https://www.ixitek.com
CORS_ORIGIN=http://localhost:5173

# ── Database (SQLite — no server/account to set up) ────────────────────
# A single local file database via db.js (see src/db.js). Leave this
# unset and it defaults to ixitek-backend/data/ixitek.db, created
# automatically on first start. WAL mode + fsync-on-commit are enabled in
# db.js so a crash mid-write can't corrupt already-saved data.
DB_PATH=./data/ixitek.db
# On Hostinger, point this at a path on a persistent volume/folder outside
# the deployed app directory if your plan wipes the app folder on redeploy
# (check with Hostinger support) — e.g. DB_PATH=/home/<user>/data/ixitek.db

# Optional: override where the backend looks for the built frontend
# (ixitek-frontend/dist). Only needed if you change the repo layout —
# leave unset for the default one-repo layout this project ships with.
# FRONTEND_DIST_PATH=../ixitek-frontend/dist

# ── Backups (protects against a deleted/corrupted file, not just crashes) ─
# The server takes an automatic, safe "hot" backup (the app can keep
# running/writing during it) on this interval, written to
# ixitek-backend/data/backups/, and prunes anything past BACKUP_RETENTION.
# You can also trigger one any time with `npm run backup`, or as the owner
# via POST /api/admin/backups. See README.md → "Backups & data durability".
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION=30
# BACKUP_DIR=./data/backups

# ── Auth ─────────────────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# ── Owner / primary admin account (auto-created on first server start) ──
# Sign in with these on the site's login page to reach the admin panel.
# Change OWNER_PASSWORD before going live, and again afterwards from a
# real device — this only seeds the account once.
OWNER_NAME=Ixitek Admin
OWNER_EMAIL=admin@ixitek.in
OWNER_PASSWORD=Ixitek@2026
