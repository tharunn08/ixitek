# Root-level gitignore. ixitek-frontend/.gitignore and ixitek-backend/.gitignore
# already cover their own trees in detail — these are the same rules applied
# at the repo root so nothing generated by the root build/start scripts (or
# an editor/OS) gets committed by accident.

node_modules/
dist/
dist-ssr/
*.local

# Never commit real environment files — only the .env.example templates.
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Logs
logs
*.log
npm-debug.log*
